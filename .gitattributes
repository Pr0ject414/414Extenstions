# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text file handling with LF line endings
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf

# Binary files - preserve exact byte-for-byte integrity (no CRLF conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
