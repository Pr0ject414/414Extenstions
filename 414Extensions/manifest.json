{
  "manifest_version": 3,
  "name": "Kyles Chrome Extensions",
  "version": "1.7",
  "description": "A collection of Chrome Extensions created by Kyle.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.fab.com/*",
    "*://*.youtube.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/default_icon.png"
  },
  "content_scripts": [
    {
      "run_at": "document_idle",
      "js": [
        "youtube_extension/content_scripts/youtubePlayerPage.js",
        "youtube_extension/content_scripts/autoHD.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    },
    {
      "run_at": "document_idle",
      "js": ["video_speed_controller/controller.js"],
      "css": ["video_speed_controller/controller.css"],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true
    },
    {
      "run_at": "document_start",
      "js": ["volume_controller/content_scripts/volumeControl.js"],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true
    },
    {
      "run_at": "document_idle",
      "matches": [
        "*://www.fab.com/listings/*",
        "*://fab.com/listings/*"
      ],
      "js": [
        "fab_extension/content_scripts/modules/productPageDomScraper.js",
        "fab_extension/content_scripts/modules/contentApi.js",
        "fab_extension/content_scripts/fabProductPage.js"
      ]
    },
    {
      "run_at": "document_idle",
      "matches": [
        "*://www.fab.com/*",
        "*://fab.com/*"
      ],
      "exclude_matches": [
        "*://www.fab.com/listings/*",
        "*://fab.com/listings/*"
      ],
      "js": [
        "fab_extension/content_scripts/modules/browsePageHider.js",
        "fab_extension/content_scripts/modules/browsePageAutoOpener.js",
        "fab_extension/content_scripts/fabBrowsePage.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "48": "icons/default_icon.png",
    "128": "icons/default_icon.png"
  },
  "options_page": "settings/settings.html"
}